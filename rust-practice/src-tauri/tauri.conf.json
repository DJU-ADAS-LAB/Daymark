{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daymark",
  "version": "0.1.2",
  "identifier": "io.daymark.desktop",
  "build": {
    "frontendDist": "../../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Daymark",
        "width": 390,
        "height": 510,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true,
        "minWidth": 365,
        "minHeight": 440,
        "maximizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/startup.nsh",
        "languages": ["Korean", "English"]
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
